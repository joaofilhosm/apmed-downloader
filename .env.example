# Copie para .env.local e preencha. Nunca faca commit do arquivo preenchido.

# OBRIGATORIA em producao (minimo 16 caracteres). Assina sessoes e licencas
# de download: quem souber este valor consegue liberar downloads sem pagar.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APMED_SESSION_SECRET=

# Mercado Pago (Pix). Painel > Suas integracoes > Credenciais de producao.
# Sem ele: em desenvolvimento os pagamentos sao SIMULADOS; em producao o
# checkout fica desativado.
MERCADOPAGO_ACCESS_TOKEN=

# Opcional: segredo do webhook (Painel > Webhooks > Assinatura secreta).
# Com ele, notificacoes sem assinatura valida sao recusadas.
MERCADOPAGO_WEBHOOK_SECRET=

# URL publica do app (https). Usada para registrar o webhook do Pix.
APP_URL=https://apmed.vercel.app

# Opcionais
LICENCA_DIAS=7
PIX_EXPIRACAO_MINUTOS=30
APMED_BASE_URL=https://gestaoapmed.com.br/provas
APMED_TIMEOUT_MS=25000
